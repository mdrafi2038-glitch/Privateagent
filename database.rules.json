{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null && auth.uid == $deviceId",
        ".write": "auth != null && auth.uid == $deviceId"
      }
    },
    "commands": {
      "$deviceId": {
        ".read": "auth != null && auth.uid == $deviceId",
        "$commandId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    }
  }
}